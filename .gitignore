# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's system of choice.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different system/python version,
#   Pipfile.lock might need to be ignored.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions of dependencies
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains specific versions of dependencies
#pdm.lock
#   pdm local configuration
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

